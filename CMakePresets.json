{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Ninja with Intel LLVM)",
      "description": "Default preset - alias for ninja-intel",
      "inherits": "ninja-intel"
    },
    {
      "name": "vs-intel",
      "displayName": "Visual Studio with Intel LLVM",
      "description": "Using Visual Studio generator with Intel compilers",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "toolset": "Intel C++ Compiler 2025",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Boost_ROOT": "$env{BOOST_ROOT}"
      }
    },
    {
      "name": "ninja-intel",
      "displayName": "Ninja with Intel LLVM (MSVC mode)",
      "description": "Using Ninja with Intel compilers in MSVC compatibility mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "icx-cl",
        "CMAKE_CXX_COMPILER": "icx-cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "Boost_ROOT": "$env{BOOST_ROOT}"
      }
    },
    {
      "name": "mingw-gcc",
      "displayName": "MinGW-gcc with Ninja",
      "description": "Using MinGW-gcc compiler with Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "Boost_ROOT": "$env{BOOST_ROOT}"
      }
    },
    {
      "name": "mingw-gcc-make",
      "displayName": "MinGW-gcc with MinGW Makefiles",
      "description": "Using MinGW-gcc compiler with MinGW Makefiles generator (no Ninja required)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "Boost_ROOT": "$env{BOOST_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs-intel",
      "configurePreset": "vs-intel",
      "configuration": "Debug"
    },
    {
      "name": "ninja-intel",
      "configurePreset": "ninja-intel"
    },
    {
      "name": "mingw-gcc",
      "configurePreset": "mingw-gcc"
    },
    {
      "name": "mingw-gcc-make",
      "configurePreset": "mingw-gcc-make"
    }
  ]
}